{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monthly routine",
  "type": "object",
  "required": [
    "schemaVersion",
    "month",
    "effectiveFrom",
    "title",
    "days"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "effectiveFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "whatsNew": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deloadWeek": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "rir": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Default target reps in reserve for the month"
    },
    "weekPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "rir": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Target reps left in the tank"
          },
          "focus": {
            "type": "string",
            "description": "One line shown on the day screen"
          },
          "deload": {
            "type": "boolean",
            "description": "Defaults to one set fewer and ~90% load"
          },
          "setDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "loadFactor": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.2
          },
          "applyTo": {
            "enum": [
              "all",
              "first"
            ]
          },
          "es": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "focus": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "week"
        ]
      }
    },
    "datePlan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rir": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "Target reps left in the tank"
          },
          "focus": {
            "type": "string",
            "description": "One line shown on the day screen"
          },
          "deload": {
            "type": "boolean",
            "description": "Defaults to one set fewer and ~90% load"
          },
          "setDelta": {
            "type": "integer",
            "minimum": -3,
            "maximum": 3
          },
          "loadFactor": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.2
          },
          "applyTo": {
            "enum": [
              "all",
              "first"
            ]
          },
          "es": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "focus": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "from"
        ]
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]{1,3}$"
          },
          "name": {
            "type": "string"
          },
          "estMinutes": {
            "type": "integer",
            "minimum": 1
          },
          "notes": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "exerciseId",
                "sets",
                "restSec"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "repRange"
                  ],
                  "not": {
                    "required": [
                      "durationSec"
                    ]
                  }
                },
                {
                  "required": [
                    "durationSec"
                  ],
                  "not": {
                    "required": [
                      "repRange"
                    ]
                  }
                }
              ],
              "properties": {
                "exerciseId": {
                  "type": "string"
                },
                "sets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "repRange": {
                  "$ref": "#/definitions/range"
                },
                "durationSec": {
                  "$ref": "#/definitions/range"
                },
                "restSec": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "group": {
                  "type": "string",
                  "pattern": "^S[0-9]$"
                },
                "notes": {
                  "type": "string"
                },
                "warmup": {
                  "type": "boolean",
                  "description": "Show the warm-up checklist (default: first exercise of the day only)"
                },
                "es": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "notes": {
                      "type": "string"
                    }
                  }
                },
                "beginner": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "description": "Overrides for people on the beginner track (only the fields given change)",
                  "properties": {
                    "exerciseId": {
                      "type": "string"
                    },
                    "sets": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "repRange": {
                      "$ref": "#/definitions/range"
                    },
                    "durationSec": {
                      "$ref": "#/definitions/range"
                    },
                    "restSec": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 600
                    },
                    "notes": {
                      "type": "string"
                    },
                    "es": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "notes": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "es": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "es": {
      "type": "object",
      "additionalProperties": false,
      "description": "Spanish text for the routine announcement",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "whatsNew": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "title"
      ],
      "description": "Monthly challenge shown on the home screen and the crew board",
      "properties": {
        "type": {
          "enum": [
            "workouts",
            "sets",
            "reps",
            "time",
            "volume",
            "manual"
          ],
          "description": "workouts: finished workouts; sets: hard sets; reps/time: total reps or seconds (optionally only exerciseIds); volume: weight × reps; manual: people tap +1 themselves"
        },
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "exerciseIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only count these exercises (sets, reps, time, volume)"
        },
        "unit": {
          "enum": [
            "kg",
            "lb"
          ],
          "description": "Unit of the target for volume challenges (converted for lb users)"
        },
        "unitLabel": {
          "type": "string",
          "description": "What a manual challenge counts, e.g. 'days with 10k steps'"
        },
        "es": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "unitLabel": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "range": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}

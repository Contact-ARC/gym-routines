{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manifest",
  "type": "object",
  "required": ["schemaVersion", "app", "routines"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": {
      "type": "object",
      "required": ["version", "downloadUrl"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "notes": { "type": "string" },
        "downloadUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "exercisesFile": { "type": "string" },
    "routines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["month", "file", "effectiveFrom"],
        "additionalProperties": false,
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
          "file": { "type": "string" },
          "effectiveFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
